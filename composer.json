{
    "name": "soup-97/fy-theme",
    "description": "FY Theme — a deeply customizable, modern theme for Flarum 2.0 with live preview, presets and per-user personalization.",
    "keywords": ["flarum", "theme", "dark mode", "customization"],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "flarum/core": "^2.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Soup97\\FyTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Soup97\\FyTheme\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c tests/phpunit.xml"
    },
    "extra": {
        "flarum-extension": {
            "title": "FY Theme",
            "category": "theme",
            "icon": {
                "name": "fas fa-paint-brush",
                "color": "#fff",
                "backgroundColor": "#7c3aed"
            }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
