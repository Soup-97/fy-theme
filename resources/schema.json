{
  "version": 1,
  "groups": [
    { "id": "colors", "icon": "fas fa-palette", "label": "Colors" },
    { "id": "typography", "icon": "fas fa-font", "label": "Typography" },
    { "id": "layout", "icon": "fas fa-columns", "label": "Layout" },
    { "id": "header", "icon": "fas fa-window-maximize", "label": "Header" },
    { "id": "hero", "icon": "fas fa-flag", "label": "Welcome hero" },
    { "id": "discussions", "icon": "fas fa-list", "label": "Discussion list" },
    { "id": "posts", "icon": "fas fa-comment-alt", "label": "Posts" },
    { "id": "effects", "icon": "fas fa-magic", "label": "Effects" },
    { "id": "components", "icon": "fas fa-puzzle-piece", "label": "Components" },
    { "id": "personalization", "icon": "fas fa-user-cog", "label": "Personalization" },
    { "id": "advanced", "icon": "fas fa-code", "label": "Advanced" }
  ],
  "fonts": {
    "system": { "label": "System UI", "stack": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Ubuntu, Roboto, Helvetica, Arial, sans-serif" },
    "inter": { "label": "Inter", "stack": "\"Inter\", system-ui, sans-serif", "google": "Inter:wght@400;500;600;700;800" },
    "roboto": { "label": "Roboto", "stack": "\"Roboto\", system-ui, sans-serif", "google": "Roboto:wght@400;500;700;900" },
    "open-sans": { "label": "Open Sans", "stack": "\"Open Sans\", system-ui, sans-serif", "google": "Open+Sans:wght@400;500;600;700;800" },
    "nunito": { "label": "Nunito", "stack": "\"Nunito\", system-ui, sans-serif", "google": "Nunito:wght@400;500;600;700;800" },
    "poppins": { "label": "Poppins", "stack": "\"Poppins\", system-ui, sans-serif", "google": "Poppins:wght@400;500;600;700;800" },
    "lato": { "label": "Lato", "stack": "\"Lato\", system-ui, sans-serif", "google": "Lato:wght@400;700;900" },
    "manrope": { "label": "Manrope", "stack": "\"Manrope\", system-ui, sans-serif", "google": "Manrope:wght@400;500;600;700;800" },
    "outfit": { "label": "Outfit", "stack": "\"Outfit\", system-ui, sans-serif", "google": "Outfit:wght@400;500;600;700;800" },
    "dm-sans": { "label": "DM Sans", "stack": "\"DM Sans\", system-ui, sans-serif", "google": "DM+Sans:wght@400;500;600;700;800" },
    "source-sans": { "label": "Source Sans 3", "stack": "\"Source Sans 3\", system-ui, sans-serif", "google": "Source+Sans+3:wght@400;500;600;700;800" },
    "ibm-plex": { "label": "IBM Plex Sans", "stack": "\"IBM Plex Sans\", system-ui, sans-serif", "google": "IBM+Plex+Sans:wght@400;500;600;700" },
    "space-grotesk": { "label": "Space Grotesk", "stack": "\"Space Grotesk\", system-ui, sans-serif", "google": "Space+Grotesk:wght@400;500;600;700" },
    "merriweather": { "label": "Merriweather (serif)", "stack": "\"Merriweather\", Georgia, serif", "google": "Merriweather:wght@400;700;900" },
    "playfair": { "label": "Playfair Display (serif)", "stack": "\"Playfair Display\", Georgia, serif", "google": "Playfair+Display:wght@400;600;700;800" },
    "jetbrains-mono": { "label": "JetBrains Mono (mono)", "stack": "\"JetBrains Mono\", ui-monospace, monospace", "google": "JetBrains+Mono:wght@400;500;700" }
  },
  "options": [
    { "key": "accent", "group": "colors", "type": "color", "default": "", "cssVar": "--fy-accent", "label": "Accent color", "help": "Overrides the forum primary color for buttons, links and highlights. Leave empty to use the color from Appearance." },
    { "key": "accent2", "group": "colors", "type": "color", "default": "#a855f7", "cssVar": "--fy-accent-2", "label": "Secondary accent", "help": "Second stop of all gradients." },
    { "key": "gradientAngle", "group": "colors", "type": "range", "default": 135, "min": 0, "max": 360, "step": 5, "unit": "deg", "cssVar": "--fy-gradient-angle", "label": "Gradient angle" },
    { "key": "lightBg", "group": "colors", "type": "color", "default": "", "cssVar": "--fy-light-bg", "label": "Light mode background" },
    { "key": "lightSurface", "group": "colors", "type": "color", "default": "", "cssVar": "--fy-light-surface", "label": "Light mode surface", "help": "Background of cards, panels and dropdowns." },
    { "key": "darkBg", "group": "colors", "type": "color", "default": "", "cssVar": "--fy-dark-bg", "label": "Dark mode background" },
    { "key": "darkSurface", "group": "colors", "type": "color", "default": "", "cssVar": "--fy-dark-surface", "label": "Dark mode surface" },

    { "key": "fontBody", "group": "typography", "type": "font", "default": "system", "cssVar": "--fy-font-body", "label": "Body font" },
    { "key": "fontHeading", "group": "typography", "type": "font", "default": "inherit", "cssVar": "--fy-font-heading", "label": "Heading font", "allowInherit": true },
    { "key": "fontScale", "group": "typography", "type": "range", "default": 100, "min": 80, "max": 130, "step": 1, "cssVar": "--fy-font-scale", "label": "Font scale (%)" },
    { "key": "lineHeight", "group": "typography", "type": "range", "default": 1.6, "min": 1.2, "max": 2, "step": 0.05, "cssVar": "--fy-line-height", "label": "Line height" },
    { "key": "headingWeight", "group": "typography", "type": "select", "default": "700", "cssVar": "--fy-heading-weight", "label": "Heading weight",
      "choices": { "400": "Regular", "500": "Medium", "600": "Semibold", "700": "Bold", "800": "Extra bold", "900": "Black" } },

    { "key": "containerWidth", "group": "layout", "type": "range", "default": 0, "auto": 0, "min": 0, "max": 1920, "step": 10, "unit": "px", "cssVar": "--fy-container", "label": "Container width", "help": "0 keeps Flarum's responsive widths." },
    { "key": "sidebarPosition", "group": "layout", "type": "select", "default": "left", "attr": true, "label": "Sidebar position", "choices": { "left": "Left", "right": "Right" } },
    { "key": "sidebarWidth", "group": "layout", "type": "range", "default": 0, "auto": 0, "min": 0, "max": 380, "step": 5, "unit": "px", "cssVar": "--fy-sidebar-width", "label": "Sidebar width", "help": "0 keeps Flarum's responsive widths." },
    { "key": "stickySidebar", "group": "layout", "type": "bool", "default": true, "attr": true, "label": "Sticky sidebar" },
    { "key": "density", "group": "layout", "type": "select", "default": "comfortable", "attr": true, "label": "Density", "choices": { "compact": "Compact", "comfortable": "Comfortable", "spacious": "Spacious" } },
    { "key": "radius", "group": "layout", "type": "range", "default": 10, "min": 0, "max": 28, "step": 1, "unit": "px", "cssVar": "--fy-radius", "label": "Corner radius" },

    { "key": "headerStyle", "group": "header", "type": "select", "default": "glass", "attr": true, "label": "Header style",
      "choices": { "default": "Flarum default", "solid": "Solid surface", "glass": "Frosted glass", "gradient": "Accent gradient", "accent-line": "Accent underline" } },
    { "key": "headerHeight", "group": "header", "type": "range", "default": 0, "auto": 0, "min": 0, "max": 96, "step": 2, "unit": "px", "cssVar": "--fy-header-height", "label": "Header height", "help": "0 keeps the default height." },
    { "key": "headerBlur", "group": "header", "type": "range", "default": 14, "min": 0, "max": 40, "step": 1, "unit": "px", "cssVar": "--fy-header-blur", "label": "Glass blur" },
    { "key": "headerShadow", "group": "header", "type": "bool", "default": true, "attr": true, "label": "Header shadow" },

    { "key": "heroStyle", "group": "hero", "type": "select", "default": "gradient", "attr": true, "label": "Hero style",
      "choices": { "default": "Flarum default", "gradient": "Accent gradient", "image": "Background image", "minimal": "Minimal", "hidden": "Hidden" } },
    { "key": "heroImage", "group": "hero", "type": "url", "default": "", "cssVar": "--fy-hero-image", "format": "url", "label": "Hero image URL" },
    { "key": "heroOverlay", "group": "hero", "type": "range", "default": 45, "min": 0, "max": 95, "step": 5, "unit": "%", "cssVar": "--fy-hero-overlay", "label": "Image overlay darkness" },
    { "key": "heroAlign", "group": "hero", "type": "select", "default": "center", "attr": true, "label": "Text alignment", "choices": { "left": "Left", "center": "Center" } },
    { "key": "heroMinHeight", "group": "hero", "type": "range", "default": 0, "auto": 0, "min": 0, "max": 480, "step": 10, "unit": "px", "cssVar": "--fy-hero-min-height", "label": "Minimum height", "help": "0 sizes the hero to its content." },

    { "key": "listStyle", "group": "discussions", "type": "select", "default": "cards", "attr": true, "label": "List style",
      "choices": { "classic": "Classic", "cards": "Cards", "divided": "Divided rows", "compact": "Compact" } },
    { "key": "hoverEffect", "group": "discussions", "type": "select", "default": "lift", "attr": true, "label": "Hover effect",
      "choices": { "none": "None", "lift": "Lift", "glow": "Glow", "accent-bar": "Accent bar" } },
    { "key": "avatarShape", "group": "discussions", "type": "select", "default": "circle", "attr": true, "label": "Avatar shape",
      "choices": { "circle": "Circle", "rounded": "Rounded square", "square": "Square" } },

    { "key": "postStyle", "group": "posts", "type": "select", "default": "cards", "attr": true, "label": "Post style",
      "choices": { "classic": "Classic", "cards": "Cards", "bubbles": "Chat bubbles" } },
    { "key": "highlightAuthor", "group": "posts", "type": "bool", "default": true, "attr": true, "label": "Highlight discussion author's posts" },
    { "key": "readingWidth", "group": "posts", "type": "range", "default": 0, "auto": 0, "min": 0, "max": 160, "step": 5, "unit": "ch", "cssVar": "--fy-reading-width", "label": "Max reading width", "help": "0 keeps the default." },

    { "key": "shadows", "group": "effects", "type": "select", "default": "soft", "attr": true, "label": "Shadows",
      "choices": { "none": "None", "soft": "Soft", "medium": "Medium", "strong": "Strong" } },
    { "key": "glass", "group": "effects", "type": "bool", "default": true, "attr": true, "label": "Glass dropdowns and modals" },
    { "key": "animations", "group": "effects", "type": "select", "default": "subtle", "attr": true, "label": "Animations",
      "help": "Always disabled for visitors who prefer reduced motion.",
      "choices": { "none": "None", "subtle": "Subtle", "playful": "Playful" } },
    { "key": "background", "group": "effects", "type": "select", "default": "mesh", "attr": true, "label": "Page background",
      "choices": { "none": "Plain", "gradient": "Soft gradient", "mesh": "Mesh glow", "dots": "Dot pattern", "grid": "Grid pattern", "image": "Image" } },
    { "key": "backgroundImage", "group": "effects", "type": "url", "default": "", "cssVar": "--fy-bg-image", "format": "url", "label": "Background image URL" },
    { "key": "scrollbar", "group": "effects", "type": "select", "default": "thin", "attr": true, "label": "Scrollbar",
      "choices": { "default": "Browser default", "thin": "Thin", "accent": "Accent colored" } },

    { "key": "announcementText", "group": "components", "type": "text", "default": "", "maxLength": 500, "label": "Announcement bar text", "help": "Shown above the content on every page. Leave empty to hide." },
    { "key": "announcementLink", "group": "components", "type": "url", "default": "", "label": "Announcement link" },
    { "key": "announcementStyle", "group": "components", "type": "select", "default": "accent", "label": "Announcement style",
      "choices": { "accent": "Accent gradient", "info": "Info", "success": "Success", "warning": "Warning" } },
    { "key": "announcementDismissible", "group": "components", "type": "bool", "default": true, "label": "Announcement can be dismissed" },
    { "key": "progressBar", "group": "components", "type": "bool", "default": true, "label": "Reading progress bar on discussions" },
    { "key": "backToTop", "group": "components", "type": "bool", "default": true, "label": "Back-to-top button" },
    { "key": "footerEnabled", "group": "components", "type": "bool", "default": false, "label": "Show footer" },
    { "key": "footerText", "group": "components", "type": "text", "default": "", "maxLength": 300, "label": "Footer text", "help": "Use {year} for the current year." },
    { "key": "footerLinks", "group": "components", "type": "textarea", "default": "", "maxLength": 2000, "label": "Footer links", "help": "One per line: Label | https://example.com" },

    { "key": "userAccent", "group": "personalization", "type": "bool", "default": true, "label": "Users may pick their own accent color" },
    { "key": "userDensity", "group": "personalization", "type": "bool", "default": true, "label": "Users may pick their own density" },
    { "key": "userFontScale", "group": "personalization", "type": "bool", "default": true, "label": "Users may pick their own font scale" },

    { "key": "customCss", "group": "advanced", "type": "textarea", "default": "", "maxLength": 50000, "code": true, "label": "Theme CSS", "help": "Added after the theme's own styles. Every option is also available as a CSS variable (e.g. var(--fy-accent))." }
  ]
}
